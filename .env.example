SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to False to run the non-spatial parts of the project without GDAL/GEOS.
USE_GIS=True

DB_NAME=osint_sentry
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# OSGeo4W DLLs — GeoDjango cannot find these on Windows without an explicit path.
# The gdal DLL name is version-suffixed; check C:/OSGeo4W/bin for the real name.
GDAL_LIBRARY_PATH=C:/OSGeo4W/bin/gdal311.dll
GEOS_LIBRARY_PATH=C:/OSGeo4W/bin/geos_c.dll

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
