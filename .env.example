SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite | postgres
DB_BACKEND=sqlite

# Needs GDAL/GEOS installed plus a spatial database (SpatiaLite or PostGIS).
# Off means the reportgis app is not loaded at all.
USE_GIS=False

# Only read when DB_BACKEND=postgres.
# DB_NAME=osint_sentry
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# OSGeo4W DLLs — only needed when USE_GIS=True. The gdal DLL name is
# version-suffixed; check C:/OSGeo4W/bin for the real name.
# GDAL_LIBRARY_PATH=C:/OSGeo4W/bin/gdal311.dll
# GEOS_LIBRARY_PATH=C:/OSGeo4W/bin/geos_c.dll

# Where the analyst console is served from; shown at the API root.
FRONTEND_URL=http://localhost:5173

# Module 1 looks up real domain registration dates over RDAP (the registries'
# own JSON API — no key, no scraping). This is the only outbound call the
# credibility engine makes. Set it to NullRegistryClient to run fully offline;
# domain age then reads as unknown rather than being assumed.
# CREDIBILITY_REGISTRY_CLIENT=credibility.registry.RdapClient
# CREDIBILITY_RDAP_TIMEOUT=10.0
# Put a real contact address here before pointing this at anyone's servers.
# CREDIBILITY_USER_AGENT=OSINT-Sentry/1.0 (+registry lookup; contact: you@example.com)

# Module 2 reads real web pages. Set CONTENT_FETCHER to NullFetcher to make the
# system contact nobody; content then only arrives through /api/content/ingest/.
# CONTENT_FETCHER=content.fetchers.WebFetcher
# Put a real contact address here before pointing this at anyone's servers.
# CONTENT_USER_AGENT=OSINT-Sentry/1.0 (+content fetcher; contact: you@example.com)
# Limits, not tuning knobs — raising them makes this a worse citizen.
# CONTENT_CRAWL_DELAY=2.0          seconds between requests to one host
# CONTENT_FETCH_TIMEOUT=15.0
# CONTENT_MAX_BYTES=2000000
# CONTENT_MAX_ITEMS_PER_FETCH=10
# False stores each feed entry's summary instead of fetching the article page.
# CONTENT_FETCH_BODIES=True
# Refuses hostnames that resolve to private/loopback/link-local addresses.
# Only turn this off to crawl a site on your own network, and never where
# users can submit URLs.
# CONTENT_ALLOW_PRIVATE_HOSTS=False

# Cross-referencing a story against other outlets for the 0-10 rating.
# NullSearch disables it, and reports itself *unavailable* rather than empty,
# so turning it off can never read as "nothing corroborates this".
# CORROBORATION_SEARCH=content.corroborate.CompositeSearch
# CORROBORATION_WINDOW_DAYS=7      how far either side of publication counts
# CORROBORATION_MAX_QUERY_TERMS=4  backends AND terms; long queries find nothing
# CORROBORATION_MIN_SIMILARITY=0.30
# CORROBORATION_MAX_FEEDS=12       tracked feeds read per check
# CORROBORATION_FEED_CACHE_TTL=900

# filesystem:// needs no server. Swap to redis://localhost:6379/0 when you have one.
CELERY_BROKER_URL=filesystem://
# CELERY_RESULT_BACKEND defaults to django-db (results stored in the project DB).
